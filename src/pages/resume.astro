---
export const prerender = true; // Static marketing page; only /admin/** is server-rendered.
import BaseLayout from '../layouts/BaseLayout.astro';
import GlitchHeading from '../components/GlitchHeading.astro';
import CredlyBadge from '../components/CredlyBadge.astro';

/*
  Résumé content. Synced from Ceryce's canonical résumé markdown (2026-09-12). Home address,
  phone number, and personal email are intentionally omitted from this public page — contact is
  email + LinkedIn + GitHub only. The downloadable PDF is the redacted render of the same markdown.
*/
const summary =
  'AI-focused software architect with over a decade of full-stack engineering experience, now specializing in agentic systems, LLM-powered developer tooling, and spec-driven AI development pipelines that have measurably accelerated delivery by up to 3×. Adept in architecture design, overseeing implementations, mentoring teams, designing multi-agent AI orchestration, maintaining strong client relationships, and acquiring deep domain expertise. Committed to translating emerging AI capabilities into reliable, production-grade systems that expand what one engineer can deliver.';

const links = [
  { label: 'GitHub', href: 'https://github.com/kumouri' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/kumouri' },
  { label: 'contact@ceryce.com', href: 'mailto:contact@ceryce.com' },
];

type Role = {
  title: string;
  org: string;
  period: string;
  env?: string;
  points: string[];
};

const experience: Role[] = [
  {
    title: 'Lead Engineer / AI Engineer',
    org: 'InRhythm, O’Fallon, IL',
    period: 'Jan 2026 – Present',
    env: 'Java 21 · Spring Boot · Spring Batch · Amazon EKS · Control-M · GitHub Copilot',
    points: [
      'Designed and deployed a Spec Driven Development AI DLC pipeline to modernize legacy PL/SQL Oracle batch jobs running on the database host box to individual containerized Spring Batch jobs running in EKS. The legacy jobs were Control-M scheduled, and some remain so post-migration. This sped up development ~3× — a quarter per batch job down to a month.',
      'Generalized the above pipeline to modernize a Struts-based JSP legacy monolithic webapp into a modern Angular front end backed by domain-specific Spring Boot microservices. This improved development times by ~2×.',
      'Developed a reflexion memory system for the pipeline for it to learn from its mistakes and learn the client’s patterns and architecture better.',
    ],
  },
  {
    title: 'Founder',
    org: 'KMO Solutions Foundry',
    period: 'Apr 2025 – Jan 2026',
    points: [
      'Founded an independent web/hosting/integrations consultancy; designed and built its platform and portfolio, including an AI-native CRM, an AI call screener, and marketing/demo sites.',
    ],
  },
  {
    title: 'Senior Software Engineer',
    org: 'Bank of America, Chicago, IL',
    period: 'Apr 2024 – Apr 2025',
    env: 'Java 17 · Spring · Spring Boot · DB2 · OpenShift · Kubernetes · Git · TDD · Kafka',
    points: [
      'Contributing senior developer on a SAFe agile team of six developers, three onshore and three offshore (in India).',
      'Added new REST endpoints to a microservice for manipulating ACH transfer limits, vastly speeding up changes to them by eliminating the need for an entire application rebuild.',
      'Added resiliency in ACH fraud detection by adding circuit breakers to save resources and using the store-and-forward pattern with Kafka to store the transactions that were unable to process during downtime.',
    ],
  },
  {
    title: 'Senior Software Engineer',
    org: 'PNC Bank, Chicago, IL',
    period: 'Mar 2023 – Apr 2024',
    env: 'Java 21 · Spring Boot · Spring Data · MySQL · Docker · Git · TDD',
    points: [
      'Led a team of three building a greenfield Spring Boot middleware application in Java 21 that translated between legacy applications emitting batches and a new payment gateway accepting only REST calls, letting an entire fleet of legacy applications reach the new gateway without any of them being modernized.',
      'Designed it to be reconfigured rather than rewritten: chunk collection (configurable thread count and per-thread chunk sizing), batch-processing rules, and send logic are each independently swappable through Spring IoC, so a new batch format or a different downstream gateway reuses the collection-and-forwarding core instead of reimplementing it.',
      'Delivered under PNC DevOps standards — TDD, CI/CD on internal RHEL OpenShift, full monitoring/logging coverage.',
    ],
  },
  {
    title: 'Senior Software Engineer',
    org: 'Loop Commerce, Columbia, MO',
    period: 'Oct 2022 – Dec 2022',
    points: ['Loop Commerce was shut down by its parent company, Synchrony Bank, one month after I was hired.'],
  },
  {
    title: 'Senior Software Engineer',
    org: 'SuprTek, O’Fallon, IL',
    period: 'May 2018 – Aug 2022',
    env: 'Java 17 · Spring · JavaScript · Node.js · React · MongoDB · Git · TDD',
    points: [
      'Led a team of eight converting a legacy, spreadsheet-driven logistics line of business as part of a full-scale USTRANSCOM application rebuild.',
      'Designed the data, service, REST API, and messaging layers for the Coronet line of business using MongoDB, Java 17, Spring Boot, and Kafka, and participated in the design and implementation of Coronet’s React-based UI.',
      'Served as interim Product Owner for six months, leading client interactions and advocating for the client in team decisions.',
    ],
  },
  {
    title: 'Senior Software Engineer',
    org: 'DMI, Carmel, IN',
    period: 'Nov 2017 – Mar 2018',
    env: 'Docker Enterprise · Red Hat Linux · Bash · JSON · Artifactory · Jenkins · Microsoft Team Foundation Server · Maven · sed',
    points: [
      'Managed the transition of Allison Transmission’s DevOps infrastructure from external DMI hosting to internal hosting.',
      'Migrated Jenkins, Team Foundation Server, Artifactory, and Git to Docker, building an image per service and moving the existing Maven artifacts into the new Artifactory.',
    ],
  },
  {
    title: 'Healthcare Informaticist',
    org: 'BJC Healthcare, St. Louis, MO',
    period: 'Nov 2014 – Jul 2017',
    env: 'Java 6/7/8 · Spring · Struts · JavaScript · jQuery · Sybase · DB2 · SQL Server · PostgreSQL · Python · Linux · Bash · Git · CVS · Tomcat · MQ Series · Maven · Ant · Jira (administration and use)',
    points: [
      'Led design and implementation of BJC’s CDC grant-funded software solution for antibiotic use and resistance reporting.',
      'Led conversion of major projects’ build infrastructure to Maven, mentoring six team members on its use.',
      'Maintained and updated hospital-acquired disease reporting infrastructure using Java (6, 7, & 8), Spring, Struts, JavaScript, and jQuery.',
      'Interpreted CDC technical guides to update and implement new XML reports for CDC submission.',
    ],
  },
  {
    title: 'Software Associate',
    org: 'National Information Solutions Cooperative, St. Louis, MO',
    period: 'Jun 2014 – Nov 2014',
    env: 'Java 5 → 8 · Swing · JDBC · SQL · Oracle Database',
    points: [
      'Supported the CIS and Cash Register Java applications, focused on adding new UI pages to Cash Register.',
      'Improved the performance of a SQL query by over 1,000× in relevant edge cases.',
    ],
  },
];

const skillGroups = [
  { label: 'Languages', items: ['Java (6–21)', 'Lua', 'C#', 'C++', 'JavaScript', 'Python', 'Bash', 'PowerShell', 'Lisp'] },
  { label: 'Frameworks', items: ['Spring', 'Spring Boot', 'Spring Data', 'JUnit', 'Mockito', 'Node.js'] },
  { label: 'Databases', items: ['MySQL', 'PostgreSQL', 'MongoDB', 'MSSQL', 'Oracle', 'DB2', 'Hibernate'] },
  {
    label: 'AI tooling',
    items: [
      'Claude Code',
      'Claude Agent SDK (Py & TS)',
      'GitHub Copilot',
      'Cursor',
      'Prompt engineering',
      'Agentic orchestration',
      'Subagent design',
      'Spec-driven development',
      'Skill & hook dev',
      'MCP servers',
    ],
  },
  { label: 'Ops & other', items: ['Docker', 'Tomcat', 'Caddy', 'Linux', 'Gradle', 'Maven', 'Ant', 'OAuth2', 'Kubernetes', 'OpenShift', 'Kafka', 'IBM MQ'] },
];

// Compact mirror of the résumé's projects; full write-ups live on /portfolio.
const projects = [
  [
    'Demiurge — meta-agent lifecycle system',
    'A Thrallherd-pattern meta-agent that mints, specifies, deploys, and curates a roster of specialized, long-running “Archon” agents — owning the full spec → eval-gated admission → delegation → tenure/retirement loop. Archons run as subscription-billed CLI services behind an A2A/MCP interface; the first production Archon autonomously fetches and scores job postings, researches companies, and tailors application materials under a draft-and-hold approval gate.',
  ],
  [
    'Margo — agentic chief-of-staff',
    'A persistent, local-first AI orchestrator: purpose-built subagents loaded just-in-time, proactive loops that screen calls, texts, and email and manage daily scheduling, and an “act-low / ask-high” gate that drafts-and-holds anything outbound. Observability — append-only per-turn telemetry (verbatim turns, tool calls, tokens/cost/latency) joined on one turn id and stamped with the vendor CLI version, which attributed a 40% latency / 45% cost drop across 3,000 turns to a Claude Code upgrade, not an internal change, in twenty minutes, no A/B. Security — no secret enters argv, logs, or the agent transcript: Worker secrets piped to wrangler over stdin (9 tests, one asserting the value appears nowhere in output), and a recipient-class ledger at all 6 outbound send sites that logs who was reached, never the address (51 tests). Governance — merge approvals single-use, bound to one head SHA, 24 h expiry, enforced by a fail-closed pre-tool hook; 58 owner rulings in a CI-checked ledger, 28 enforced in code; 6 blocking CI policy checks.',
  ],
  [
    'Spec-driven AI development pipeline',
    'A self-verifying, spec-first engineering pipeline with a durable task-graph runtime and typed contracts, using a dedicated verification gate so the agent doing the work never grades its own output — plus a reusable suite of 7 Claude Code skills, including context-loaders and crash recovery, to make multi-agent engineering repeatable.',
  ],
  [
    'AI-native CRM & call screener',
    'A multi-tenant customer-engagement platform — architecture, data model, and specifications mine, implementation directed through coding agents rather than hand-written — with an AI intake pipeline that screens live calls through an LLM persona that reads caller intent, transcribes voicemails into structured leads, triages submitted photos, and drafts review replies.',
  ],
  [
    'Distributed agent fleet & commodity-market automation',
    'A distributed control plane for a large fleet of autonomous client agents — a Java/Spring/PostgreSQL server tracking and commanding Lua-scripted clients in real time, plus a monitoring and command-and-control web app for fleet-wide visibility and operator intervention — and an automated commodity-market trading system that priced and executed trades across a large-scale virtual economy, with a 1,700+ function reference manual and instructional video series to onboard other operators.',
  ],
];

// Redacted PDF (no address/phone/email) lives at /public/resume.pdf.
const hasPdf = true;

// Verified digital credentials. The Credly embed (client-side embed.js) swaps each
// data-share-badge-id <div> for the badge iframe; `verify` is the JS-off / no-embed
// fallback link to the public badge. Add new badges here.
const certifications = [
  { badgeId: '4054ad95-fe1f-4fe2-a538-5f1a09673b9a', verify: 'https://www.credly.com/badges/4054ad95-fe1f-4fe2-a538-5f1a09673b9a/public_url' },
];
---

<BaseLayout
  title="Résumé"
  description="Résumé of Ceryce Armstrong — AI-focused software architect with 10+ years of full-stack engineering, specializing in agentic systems and spec-driven AI pipelines."
>
  <section class="resume">
    <div class="container resume-inner">
      <div class="resume-top">
        <div>
          <p class="eyebrow">// résumé</p>
          <GlitchHeading as="h1" text="Ceryce Armstrong" />
          <p class="resume-role">AI Architect · Full-stack engineer of 10+ years</p>
          <nav class="resume-links" aria-label="Profiles">
            {links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
          </nav>
        </div>
        {
          hasPdf ? (
            <a class="btn btn-ghost" href="/resume.pdf" download>
              Download PDF
            </a>
          ) : (
            <span class="btn btn-ghost is-disabled" aria-disabled="true">
              PDF — coming soon
            </span>
          )
        }
      </div>

      <p class="lead resume-summary">{summary}</p>

      <div class="resume-section">
        <h2>Experience</h2>
        <ol class="timeline">
          {
            experience.map((role) => (
              <li class="timeline-item">
                <div class="timeline-head">
                  <h3>
                    {role.title} <span class="at">·</span> <span class="org">{role.org}</span>
                  </h3>
                  <span class="period">{role.period}</span>
                </div>
                {role.env && <p class="role-env">{role.env}</p>}
                <ul class="role-points">
                  {role.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="resume-section">
        <h2>Skills</h2>
        <div class="skills">
          {
            skillGroups.map((g) => (
              <div class="skill-group">
                <span class="skill-label">{g.label}</span>
                <ul class="skill-items">
                  {g.items.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div class="resume-section">
        <h2>Certifications</h2>
        <ul class="certs">
          {
            certifications.map((c) => (
              <li class="cert">
                <CredlyBadge badgeId={c.badgeId} />
                <a class="cert-verify" href={c.verify} target="_blank" rel="noopener">
                  Verify on Credly ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="resume-section">
        <div class="section-head">
          <h2>Selected projects</h2>
          <a class="section-link" href="/portfolio/">Full portfolio ↗</a>
        </div>
        <ul class="projects">
          {
            projects.map(([name, desc]) => (
              <li>
                <span class="project-name">{name}</span>
                <span class="project-desc">{desc}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="resume-section">
        <h2>Education</h2>
        <div class="edu">
          <div class="edu-head">
            <h3>B.S. in Computer Science</h3>
            <span class="period">Aug 2010 – Dec 2014</span>
          </div>
          <p class="edu-org">South Dakota School of Mines &amp; Technology — Rapid City, SD</p>
        </div>
      </div>

      <p class="resume-contact">
        Get in touch: <a href="mailto:contact@ceryce.com">contact@ceryce.com</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-inner {
    max-width: 50rem;
  }

  .resume-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .resume-role {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    color: var(--toxic-green);
    font-size: 0.95rem;
  }

  .resume-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .resume-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .resume-links a:hover {
    color: var(--toxic-green);
  }

  .is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .resume-summary {
    margin-top: 2rem;
    color: var(--text-muted);
  }

  .resume-section {
    margin-top: 3rem;
  }

  .resume-section h2 {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-head h2 {
    flex: 1;
  }

  .section-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--toxic-green);
    text-decoration: none;
    white-space: nowrap;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .timeline-item {
    border-left: 2px solid var(--border-bright);
    padding-left: 1.25rem;
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.45rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--toxic-green);
    box-shadow: var(--glow-green);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .timeline-head h3 {
    color: var(--text);
  }

  .at {
    color: var(--text-dim);
  }

  .org {
    color: var(--purple-soft);
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .role-env {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .role-points {
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
    color: var(--text-muted);
  }

  .role-points li {
    margin-bottom: 0.4rem;
  }

  .role-points li::marker {
    color: var(--kumouri-purple);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.5rem;
  }

  .skill-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 0.6rem;
  }

  .skill-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-items li {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .projects li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .project-name {
    color: var(--text);
    font-weight: 600;
  }

  .project-desc {
    color: var(--text-muted);
  }

  .certs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .cert-verify {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--toxic-green);
    text-decoration: none;
    white-space: nowrap;
  }

  .cert-verify:hover {
    text-decoration: underline;
  }

  .edu-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .edu-head h3 {
    color: var(--text);
  }

  .edu-org {
    margin-top: 0.3rem;
    color: var(--purple-soft);
  }

  .resume-contact {
    margin-top: 3rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text-muted);
  }
</style>
