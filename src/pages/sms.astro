---
export const prerender = true; // Static marketing page, rendered from /legal at build time.
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
// Canonical source of truth lives in /legal — render HTML from it, never hand-edit HTML.
// src/lib/smsProgram.ts inlines it via Vite's `?raw` and pulls out the confirmation reply, which
// the generated illustration (src/pages/sms-opt-in.svg.ts) quotes word for word.
import { optInConfirmation, SMS_NUMBER, smsProgramSource as source } from '../lib/smsProgram';
import { optInSvg } from '../lib/smsOptInSvg';

// Strip the leading internal-notes HTML comment, then split at the marker where the
// opt-in figure goes (between "How the owner opts in" and "Consent language").
const cleaned = source.replace(/^\s*<!--[\s\S]*?-->\s*/, '');
const [before, after = ''] = cleaned.split('<!-- opt-in-figure -->');
const render = (md: string) => marked.parse(md, { async: false }) as string;
---

<BaseLayout
  title="Margo SMS notifications"
  description="Margo SMS notifications, operated by KMO Solutions Foundry LLC: owner-only opt-in, consent language, message types, frequency, and STOP/HELP."
>
  <section class="legal">
    <div class="container">
      <article class="prose">
        <Fragment set:html={render(before)} />

        <figure class="opt-in">
          <p class="step-label">Step 2 · text START to {SMS_NUMBER}</p>
          <img
            src="/sms-opt-in.svg"
            width={optInSvg.width}
            height={optInSvg.height}
            alt={`Illustration of the opt-in message flow: a phone text thread with Margo SMS notifications, KMO Solutions Foundry LLC, at ${SMS_NUMBER}. The owner texts START, and Margo's automatic reply reads: ${optInConfirmation}`}
          />
          <figcaption>
            Illustration of the opt-in message flow (not a live screenshot). Only the account owner can
            complete it, after saving her own mobile number in Margo's private settings (step 1) — there is
            no public sign-up.
          </figcaption>
        </figure>

        <Fragment set:html={render(after)} />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .opt-in {
    margin: 0 0 1.6em;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius-lg);
  }

  .step-label {
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--toxic-green);
  }

  .opt-in img {
    display: block;
    width: 100%;
    max-width: 25rem;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
